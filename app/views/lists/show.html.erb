<div class="bg-dark text-white text-center py-5 mb-4">
  <h1><%= @list.name %></h1>
  <span class="badge bg-warning text-dark"><%= pluralize(@list.bookmarks.count, "movie") %></span>
</div>

<div class="container mb-5">
  <div class="d-flex justify-content-between mb-4">
    <%= link_to "← All lists", lists_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-success btn-sm" %>
  </div>

  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-12 col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
          <% if bookmark.movie.poster_url.present? %>
            <%= image_tag bookmark.movie.poster_url, class: "card-img-top", alt: bookmark.movie.title,
                style: "height: 220px; object-fit: cover;" %>
          <% end %>
          <div class="card-body">
            <h5 class="card-title">
              <%= bookmark.movie.title %>
              <small class="text-muted">• <%= bookmark.movie.rating %> ★</small>
            </h5>
            <p class="card-text small"><%= bookmark.movie.overview %></p>
          </div>
          <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <small class="fst-italic">“<%= bookmark.comment %>”</small>
            <%= button_to "delete", bookmark_path(bookmark), method: :delete,
                class: "btn btn-link btn-sm text-danger p-0" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
